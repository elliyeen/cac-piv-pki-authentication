flowchart TB
  user["User<br/>smart card + browser"]:::neutral

  subgraph edge["Gateway boundary (not in this repository)"]
    gw["Trusted gateway<br/>client-certificate TLS<br/>identity assertion<br/><b>SIMULATED</b> by the test harness"]:::sim
  end

  subgraph lib["Validation library (this repository)"]
    cert["Certificate chain + signed-CRL validation<br/>used by the gateway or the app<br/><b>IMPLEMENTED</b>"]:::impl
  end

  subgraph app["Application boundary"]
    prov["Provenance check<br/>mTLS pin, or IPv4 allowlist (weaker)<br/><b>IMPLEMENTED</b>"]:::impl
    sess["Sessions<br/>idle + absolute timeout, CSRF, revocation<br/><b>IMPLEMENTED</b> (in-memory store)"]:::impl
    audit["Audit events<br/>no builder or sink in this repository<br/><b>PLANNED</b>"]:::plan
    ui["UI, role mapping, account linking<br/><b>PLANNED</b> (not in this repository)"]:::plan
  end

  subgraph data["Data and audit"]
    db[("Database<br/>users, roles, sessions, audit<br/><b>PLANNED</b> (not implemented)")]:::plan
    sink["Audit sink / SIEM<br/><b>PLANNED</b>"]:::plan
  end

  crl["CRL endpoint<br/><b>SIMULATED</b> in tests"]:::sim

  user -->|"client certificate"| gw
  gw -->|"request + identity headers"| prov
  prov --> sess
  prov --> audit
  sess -.->|"future durable store"| db
  audit -.-> sink
  ui -.-> db
  gw -.->|"uses"| cert
  cert -->|"fetch + verify signature"| crl


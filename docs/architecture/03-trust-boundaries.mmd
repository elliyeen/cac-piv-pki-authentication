flowchart LR
  subgraph z0["Zone 0 - untrusted: internet, browsers, any HTTP header"]
    c["Client<br/>can send any header, including x-edipi"]:::neutral
  end

  subgraph z1["Zone 1 - gateway: the only component that may assert identity"]
    g["Trusted gateway<br/>terminates client-certificate TLS<br/>deletes inbound identity headers<br/>validates the certificate and revocation<br/><b>SIMULATED</b>"]:::sim
  end

  subgraph z2["Zone 2 - application origin: reachable only from the gateway"]
    p["Provenance verification<br/>mTLS pin, or IPv4 allowlist (weaker)<br/>fails closed, runs before parsing headers<br/><b>IMPLEMENTED</b>"]:::impl
    s["Session + CSRF + revocation<br/><b>IMPLEMENTED</b>"]:::impl
  end

  subgraph z3["Zone 3 - data: application-only credentials"]
    d[("Database and audit sink<br/><b>PLANNED</b>")]:::plan
  end

  r["Revocation source<br/>signed CRLs, bounded staleness<br/><b>SIMULATED</b> in tests"]:::sim

  c -->|"untrusted request"| g
  g -->|"identity headers + proof of origin"| p
  p --> s
  s -.-> d
  g -->|"verify CRL signature, fail closed"| r


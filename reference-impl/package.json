{
  "name": "@elliyeen/cac-piv-reference",
  "version": "0.1.0",
  "private": true,
  "description": "CAC/PIV PKI Authentication Reference Implementation",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "test:security": "vitest run --project security --passWithNoTests",
    "test:certs": "vitest run --project certs --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "certs:generate": "tsx ../scripts/generate-certs.ts",
    "demo": "tsx ../scripts/demo.ts"
  },
  "dependencies": {
    "@peculiar/x509": "1.12.0",
    "jose": "5.3.0",
    "zod": "3.23.0"
  },
  "devDependencies": {
    "@types/node": "20.19.1",
    "typescript": "7.0.2",
    "vitest": "3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "tsx": "4.20.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
